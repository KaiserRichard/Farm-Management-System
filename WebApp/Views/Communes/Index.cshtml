@model IEnumerable<CoreBusiness.Commune>
@{
    var districts = ViewBag.Districts as IEnumerable<CoreBusiness.District>;
}

<h2>Commune Management</h2>

<form asp-action="Create" method="post">
    <div>
        <label>Code</label><br />
        <input name="Code" />
    </div>

    <div>
        <label>Name</label><br />
        <input name="Name" required />
    </div>

    <div>
        <label>District</label><br />
        <select name="DistrictId" required>
            <option value="">-- Select District --</option>
            @foreach (var d in districts!)
            {
                <option value="@d.Id">@d.Name</option>
            }
        </select>
    </div>

    <br />
    <button type="submit">Add Commune</button>
</form>

<hr />

<table border="1">
    <thead>
        <tr>
            <th>Id</th>
            <th>Code</th>
            <th>Name</th>
            <th>DistrictId</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var c in Model)
        {
            <tr>
                <td>@c.Id</td>
                <td>@c.Code</td>
                <td>@c.Name</td>
                <td>@c.DistrictId</td>
            </tr>
        }
    </tbody>
</table>
