@{
    ViewData["Title"] = "Bảng điều khiển";
}

<div class="container mt-4">
    <div class="p-5 mb-4 bg-light rounded-3 shadow-sm border-start border-5 border-primary">
        <div class="container-fluid py-2">
            <h1 class="display-5 fw-bold text-dark"><i class="fas fa-farm"></i> Hệ Thống Quản Lý Trang Trại</h1>
            <p class="col-md-8 fs-4 text-muted">Chào mừng bạn trở lại. Đây là tình hình trang trại hôm nay.</p>
        </div>
    </div>

    <div class="row">
        <div class="col-md-4">
            <div class="card bg-primary text-white mb-4 shadow border-0">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <div>
                        <div class="small text-white-50 text-uppercase fw-bold">Tổng vật nuôi</div>
                        <div class="display-4 fw-bold">@ViewBag.TotalAnimals</div>
                    </div>
                    <i class="fas fa-piggy-bank fa-3x text-white-50"></i>
                </div>
                <div class="card-footer d-flex align-items-center justify-content-between small bg-dark bg-opacity-10 border-0">
                    <a class="text-white stretched-link text-decoration-none" asp-controller="Animals" asp-action="Index">Xem danh sách</a>
                    <i class="fas fa-angle-right"></i>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card bg-warning text-dark mb-4 shadow border-0">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <div>
                        <div class="small text-dark-50 text-uppercase fw-bold">Lịch tiêm chờ</div>
                        <div class="display-4 fw-bold">@ViewBag.PendingVaccinations</div>
                    </div>
                    <i class="fas fa-syringe fa-3x text-dark-50"></i>
                </div>
                <div class="card-footer d-flex align-items-center justify-content-between small bg-dark bg-opacity-10 border-0">
                    <a class="text-dark stretched-link text-decoration-none" asp-controller="Vaccinations" asp-action="Index">Kiểm tra lịch</a>
                    <i class="fas fa-angle-right"></i>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card bg-danger text-white mb-4 shadow border-0">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <div>
                        <div class="small text-white-50 text-uppercase fw-bold">Vật tư sắp hết</div>
                        <div class="display-4 fw-bold">@ViewBag.LowStockSupplies</div>
                    </div>
                    <i class="fas fa-exclamation-triangle fa-3x text-white-50"></i>
                </div>
                <div class="card-footer d-flex align-items-center justify-content-between small bg-dark bg-opacity-10 border-0">
                    <a class="text-white stretched-link text-decoration-none" asp-controller="Supplies" asp-action="Index">Vào kho</a>
                    <i class="fas fa-angle-right"></i>
                </div>
            </div>
        </div>
    </div>
</div>