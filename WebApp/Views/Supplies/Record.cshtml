@model CoreBusiness.SupplyTransaction
@using CoreBusiness

@{
    ViewData["Title"] = "Giao dịch vật tư";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow">
                <div class="card-header bg-primary text-white">
                    <h3 class="mb-0"><i class="fas fa-exchange-alt"></i> Nhập / Xuất Kho</h3>
                </div>
                <div class="card-body">
                    <form asp-action="Record" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Vật tư trong kho</label>
                            <select asp-for="SupplyId" class="form-select" asp-items="ViewBag.Supplies">
                                <option value="">-- Chọn vật tư --</option>
                            </select>
                            <span asp-validation-for="SupplyId" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Loại giao dịch</label>
                            <select asp-for="ActionType" class="form-select">
                                <option value="@((int)TransactionType.Import)">Nhập kho (+)</option>
                                <option value="@((int)TransactionType.Export)">Xuất kho (-)</option>
                            </select>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Số lượng</label>
                            <input asp-for="Quantity" type="number" class="form-control" placeholder="Nhập số lượng giao dịch..." />
                            <span asp-validation-for="Quantity" class="text-danger"></span>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-success btn-lg">Xác nhận lưu phiếu</button>
                            <a asp-action="Index" class="btn btn-outline-secondary">Quay lại danh sách</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}