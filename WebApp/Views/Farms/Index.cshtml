@model IEnumerable<CoreBusiness.Farm>

@{
    ViewData["Title"] = "Danh sách Trang trại";
}

<div class="container mt-4">
    <div class="card shadow">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
            <h2 class="mb-0">Danh sách Trang trại</h2>
            <a asp-controller="Farms" asp-action="Create" class="btn btn-light text-primary fw-bold">
                Thêm trang trại mới
            </a>
        </div>
        <div class="card-body">
            <table class="table table-hover border">
                <thead class="table-light">
                    <tr>
                        <th>ID</th>
                        <th>Tên Trang trại</th>
                        <th>Địa chỉ</th>
                        <th>Chủ sở hữu</th>
                        <th class="text-center">Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var farm in Model)
                        {
                            <tr>
                                <td>@farm.FarmId</td>
                                <td>@farm.Name</td>
                                <td>@farm.Address</td>
                                <td>@farm.OwnerName</td>
                                <td class="text-center">
                                    <a asp-controller="Farms"
                                       asp-action="Edit"
                                       asp-route-id="@farm.FarmId"
                                       class="btn btn-info btn-sm">Sửa</a>

                                    <a asp-controller="Farms"
                                       asp-action="Delete"
                                       asp-route-id="@farm.FarmId"
                                       class="btn btn-danger btn-sm">Xóa</a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center text-muted">Chưa có dữ liệu trang trại nào.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>