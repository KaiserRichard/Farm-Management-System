@model IEnumerable<CoreBusiness.Animal>
@{
    ViewData["Title"] = "Danh sách Vật nuôi";
}

<div class="container mt-4">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-success text-white d-flex justify-content-between align-items-center">
            <h3 class="mb-0"><i class="fas fa-piggy-bank"></i> Quản lý Vật nuôi</h3>
            <a asp-action="Create" class="btn btn-light text-success fw-bold border-0 shadow-sm">
                <i class="fas fa-plus-circle"></i> Thêm mới
            </a>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th class="ps-4">Tên vật nuôi</th>
                            <th>Loài</th>
                            <th>Tuổi</th>
                            <th>Sức khỏe</th>
                            <th>Trang trại</th>
                            <th class="text-center pe-4">Hành động</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            @foreach (var animal in Model)
                            {
                                <tr>
                                    <td class="ps-4 fw-bold">@animal.Name</td>
                                    <td><span class="badge bg-light text-dark border">@animal.Species</span></td>
                                    <td>@animal.Age tháng</td>
                                    <td>
                                        <span class="badge @(animal.HealthStatus == "Khỏe mạnh" ? "bg-success" : "bg-warning")">
                                            @animal.HealthStatus
                                        </span>
                                    </td>
                                    <td><i class="fas fa-thumbtack text-muted"></i> @animal.Farm?.Name</td>
                                    <td class="text-center pe-4">
                                        <a asp-action="Edit" asp-route-id="@animal.AnimalId" class="btn btn-sm btn-outline-info me-1">
                                            <i class="fas fa-edit"></i> Sửa
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@animal.AnimalId" class="btn btn-sm btn-outline-danger">
                                            <i class="fas fa-trash"></i> Xóa
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center py-5 text-muted">
                                    <i class="fas fa-folder-open fa-3x d-block mb-2"></i>
                                    Chưa có dữ liệu vật nuôi nào.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>