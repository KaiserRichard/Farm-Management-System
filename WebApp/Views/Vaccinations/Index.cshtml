@model IEnumerable<CoreBusiness.Vaccination>
<div class="container mt-4">
    <div class="card shadow">
        <div class="card-header bg-info text-white d-flex justify-content-between align-items-center">
            <h3 class="mb-0"><i class="fas fa-syringe"></i> Lịch Tiêm Chủng</h3>
            <a asp-action="Create" class="btn btn-dark btn-sm">Thêm lịch mới</a>
        </div>
        <div class="card-body">
            <table class="table table-hover">
                <thead><tr><th>Vật nuôi</th><th>Vaccine</th><th>Dự kiến</th><th>Trạng thái</th><th>Thao tác</th></tr></thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.Animal?.Name</td>
                            <td>@item.Supply?.Name</td>
                            <td>@item.ScheduledDate.ToShortDateString()</td>
                            <td><span class="badge @(item.IsCompleted?"bg-success":"bg-warning")">@(item.IsCompleted?"Xong":"Chờ")</span></td>
                            <td>
                                @if (!item.IsCompleted)
                                {<a asp-action="Confirm" asp-route-id="@item.VaccinationId" class="btn btn-sm btn-primary">Xác nhận tiêm</a>}
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>